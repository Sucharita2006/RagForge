# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# --- App ---
APP_NAME=ragforge
ENV=local
API_KEY=dev-demo-key

# --- Datastores (match docker-compose.yml service names) ---
DATABASE_URL=postgresql+asyncpg://ragforge:ragforge@postgres:5432/ragforge
REDIS_URL=redis://redis:6379/0

# --- LLM provider: self-hosted-first (DECISIONS.md 2026-07-30) ---
# Ollama runs natively on the host (not in Docker) so its RAM stays off the
# WSL2 cap; containers reach it via host.docker.internal.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
GEN_MODEL=qwen3:4b-instruct
GEN_TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=1024
# Must cover MAX_CONTEXT_TOKENS + system prompt/JSON-schema overhead + MAX_OUTPUT_TOKENS,
# since Ollama defaults to a 4096-token window regardless of what the model supports.
OLLAMA_NUM_CTX=8192
# CPU inference of a large context is slow; generous timeout by design.
GEN_TIMEOUT_SECONDS=600

# Optional free-tier hybrid path (Google AI Studio key, no credit card) —
# used ONLY for LLM-as-judge, golden-testset generation, and contextual
# enrichment, capped by MAX_DAILY_LLM_CALLS/MAX_DAILY_LLM_TOKENS below.
GOOGLE_API_KEY=
JUDGE_PROVIDER=ollama
JUDGE_MODEL=gemini-pro-latest
GEMINI_FLASH_MODEL=gemini-flash-latest

# Alternative free-tier eval-run generation provider (llm_provider="openrouter"
# on POST /api/eval/run) - Gemini's free tier caps at 20 req/day per model for
# a fresh project, too low for a full eval run; OpenRouter's fresh-account
# free tier is 20 req/min + 50 req/day. Never used for production /query.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# --- Embeddings / reranker (8GB CPU profile) ---
EMBEDDING_PROVIDER=bge_small
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_PROVIDER=minilm
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# minicheck package's own alias, not a HF repo id - resolves internally to
# lytang/MiniCheck-RoBERTa-Large
MINICHECK_MODEL=roberta-large

# --- Ingestion / chunking ---
UPLOAD_DIR=/app/data/uploads
# Docling's OCR fallback has no internal timeout and can run effectively
# unbounded on an image-heavy scanned PDF on CPU; falls back to pypdf if exceeded.
DOCLING_TIMEOUT_SECONDS=300
CHUNK_SIZE=512
CHUNK_OVERLAP=64
PARENT_CHUNK_SIZE=2048
CONTEXTUAL_ENRICHMENT=true

# --- Retrieval ---
DENSE_TOP_K=50
# 0 = keyword (BM25) search off; it did not help the final ranking where measured
SPARSE_TOP_K=0
RRF_K=60
RERANK_CANDIDATES=50
# the reranker only moves candidates it scores at or above this logit
RERANK_LIFT_THRESHOLD=4.0
FINAL_TOP_K=8
MAX_CONTEXT_TOKENS=6000
HYDE=false
MULTI_QUERY_N=0

# --- pgvector / query-layer latency architecture (implementation-plan.md §2.E, §3.1) ---
HNSW_M=16
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=80
HNSW_ITERATIVE_SCAN=relaxed_order
HNSW_MAX_SCAN_TUPLES=20000
# Phase 1 baseline-v0 measured plain float32 vector; Phase 2 migrates to
# halfvec as a measured before/after (implementation-plan.md §2.E).
EMBEDDING_STORAGE=halfvec

# --- Semantic cache ---
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400

# --- Trust layer ---
MINICHECK_SUPPORT_THRESHOLD=0.5
CONFIDENCE_WEIGHT_CLAIM_SUPPORT=0.5
CONFIDENCE_WEIGHT_RETRIEVAL=0.3
CONFIDENCE_WEIGHT_SUFFICIENCY=0.2
ABSTAIN_THRESHOLD=0.55

# --- Observability ---
OTEL_EXPORTER=postgres

# --- Budget guard (caps the free-tier hybrid key) ---
MAX_DAILY_LLM_CALLS=500
MAX_DAILY_LLM_TOKENS=2000000
